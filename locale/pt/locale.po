msgid "plugins.generic.quickSubmitAuthorDefaults.displayName"
msgstr "Predefinições de coautor da Submissão Rápida"

msgid "plugins.generic.quickSubmitAuthorDefaults.description"
msgstr "Abre o formulário de um novo coautor da Submissão Rápida já preenchido com o endereço de e-mail e o país da revista e com o papel de Autor, para que o editor escreva apenas o nome. Todos os campos continuam editáveis."

msgid "plugins.generic.quickSubmitAuthorDefaults.settings.intro"
msgstr "Quando um editor acrescenta um coautor na Submissão Rápida, o formulário abre com os valores escolhidos abaixo. São apenas um ponto de partida: cada um pode ser alterado antes de guardar."

msgid "plugins.generic.quickSubmitAuthorDefaults.settings.area.email"
msgstr "Endereço de e-mail"

msgid "plugins.generic.quickSubmitAuthorDefaults.settings.fillEmail"
msgstr "Preencher o endereço de e-mail de um novo coautor"

msgid "plugins.generic.quickSubmitAuthorDefaults.settings.email"
msgstr "Endereço a utilizar"

msgid "plugins.generic.quickSubmitAuthorDefaults.settings.email.description"
msgstr "Deixe vazio para utilizar o e-mail do contacto de suporte técnico da revista, ou o do contacto principal se não existir."

msgid "plugins.generic.quickSubmitAuthorDefaults.settings.supportEmail"
msgstr "Contacto de suporte técnico da revista: {$supportEmail}"

msgid "plugins.generic.quickSubmitAuthorDefaults.settings.email.invalid"
msgstr "Indique um endereço de e-mail válido ou deixe o campo vazio."

msgid "plugins.generic.quickSubmitAuthorDefaults.settings.area.country"
msgstr "País"

msgid "plugins.generic.quickSubmitAuthorDefaults.settings.fillCountry"
msgstr "Preencher o país de um novo coautor com o país da revista"

msgid "plugins.generic.quickSubmitAuthorDefaults.settings.journalCountry"
msgstr "País da revista, definido nas configurações da revista: {$journalCountry}"

msgid "plugins.generic.quickSubmitAuthorDefaults.settings.area.userGroup"
msgstr "Papel do coautor"

msgid "plugins.generic.quickSubmitAuthorDefaults.settings.fillUserGroup"
msgstr "Selecionar o papel de um novo coautor"

msgid "plugins.generic.quickSubmitAuthorDefaults.settings.userGroup"
msgstr "Papel"

msgid "plugins.generic.quickSubmitAuthorDefaults.settings.userGroup.description"
msgstr "Enquanto nenhum papel for escolhido, é utilizado o papel predefinido de Autor da revista."

msgid "plugins.generic.quickSubmitAuthorDefaults.settings.userGroup.journalDefault"
msgstr "Papel predefinido de Autor da revista"

msgid "plugins.generic.quickSubmitAuthorDefaults.settings.userGroup.invalid"
msgstr "Escolha um dos papéis de coautor desta revista."
